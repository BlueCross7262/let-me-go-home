{
  "name": "let-me-go-home",
  "version": "0.0.17",
  "description": "Lightweight Ralph + Deep Interview plugin for Claude Code.",
  "type": "module",
  "files": [
    "dist",
    "agents",
    "bridge/mcp-server.cjs",
    "hooks",
    "scripts",
    "skills",
    ".claude-plugin",
    ".mcp.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/build-namespace.mjs && node scripts/build-mcp-server.mjs",
    "build:mcp-server": "node scripts/build-mcp-server.mjs",
    "dev": "tsc --watch",
    "dev:full": "concurrently --names \"tsc,mcp\" \"tsc --watch\" \"node scripts/build-mcp-server.mjs --watch\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format": "prettier --write src/**/*.ts",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@eslint/js": "^9.39.2",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@types/node": "^22.19.7",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "let-me-go-home contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlueCross7262/let-me-go-home.git"
  },
  "bugs": {
    "url": "https://github.com/BlueCross7262/let-me-go-home/issues"
  },
  "homepage": "https://github.com/BlueCross7262/let-me-go-home#readme",
  "keywords": [
    "claude",
    "claude-code",
    "claude-code-plugin",
    "ralph",
    "deep-interview",
    "automation"
  ],
  "publishConfig": {
    "access": "public"
  }
}
