node_modules/
*.log
.env
.DS_Store
Thumbs.db

# Regenerated output. `dist/` and `bridge/` are the deliberate exception and
# are NOT ignored: this fork ships them built so the plugin installs without a
# build step. An ignore rule there silently dropped newly generated files from
# commits, which is why none is written here.
coverage/
*.tsbuildinfo
.tmp/
.tmp-*/

# This plugin's state root. `.lmgh/skills/**` is the one part meant to be
# committed — that is where project-scoped skills live.
!.lmgh/
.lmgh/*
!.lmgh/skills/
!.lmgh/skills/**

# Editors and local tooling
.idea/
.vscode/
*.code-workspace
.notes/
.serena/

# Claude Code's project directory. `.claude/skills/**` is the one part meant to
# be committed — repository-maintenance skills live there. They are not shipped:
# the manifest's `skills` array lists what the plugin exposes, and nothing under
# `.claude/` is in it.
.claude/*
!.claude/skills/
!.claude/skills/**

# Clones of upstream oh-my-claudecode, kept outside history so the fork can be
# compared against it. `upstream_fork` holds the last commit ported from
# upstream — `upstream-pick` moves it forward after every completed run, so it
# is not a fixed snapshot. `upstream_now` tracks `dev`, the branch upstream
# develops on; `main` only receives releases. `omc_fork` is the original clone
# of the fork point, kept as the immutable record of it. All three have their
# push URL disabled.
omc_fork/
upstream_fork/
upstream_now/

# Windows reads these as device names. A POSIX shell in this tree creates them
# as ordinary files instead, and then some tools cannot delete the directory
# holding them.
nul
NUL

__pycache__/
*.py[cod]
