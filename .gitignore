node_modules/
*.log
.env
.DS_Store
Thumbs.db

# Regenerated output. `dist/` and `bridge/` are the deliberate exception and
# are NOT ignored: this fork ships them built so the plugin installs without a
# build step. An ignore rule there silently dropped newly generated files from
# commits, which is why none is written here.
coverage/
*.tsbuildinfo
.tmp/
.tmp-*/

# This plugin's state root. `.lmgh/skills/**` is the one part meant to be
# committed — that is where project-scoped skills live.
!.lmgh/
.lmgh/*
!.lmgh/skills/
!.lmgh/skills/**

# Editors and local tooling
.idea/
.vscode/
*.code-workspace
.claude/
.notes/
.serena/

# Clones of upstream oh-my-claudecode, kept outside history so the fork can be
# compared against it. `upstream_fork` is pinned to v5.4.0 (5281b19e0), the
# commit this fork started from. `upstream_now` tracks `dev`, the branch
# upstream develops on — `main` has not moved past the fork point.
# `omc_fork` is the earlier clone of the same pin, superseded by
# `upstream_fork`. Its push URL is disabled.
omc_fork/
upstream_fork/
upstream_now/

# Windows reads these as device names. A POSIX shell in this tree creates them
# as ordinary files instead, and then some tools cannot delete the directory
# holding them.
nul
NUL

__pycache__/
*.py[cod]
